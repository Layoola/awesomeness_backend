{
  "info": {
    "name": "Photography Portfolio API",
    "description": "API endpoints for the photography portfolio backend",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000/api",
      "type": "string"
    },
    {
      "key": "adminApiKey",
      "value": "dev_admin_key_change_in_production",
      "type": "string"
    },
    {
      "key": "eventTypeId",
      "value": "",
      "type": "string"
    },
    {
      "key": "eventId",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Health Check",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/health",
          "host": ["{{baseUrl}}"],
          "path": ["health"]
        }
      }
    },
    {
      "name": "Event Types",
      "item": [
        {
          "name": "Create Event Type (Admin)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-API-Key",
                "value": "{{adminApiKey}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Wedding Photography\",\n  \"description\": \"Beautiful wedding moments captured forever\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/event-types",
              "host": ["{{baseUrl}}"],
              "path": ["event-types"]
            }
          }
        },
        {
          "name": "List Event Types",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/event-types",
              "host": ["{{baseUrl}}"],
              "path": ["event-types"]
            }
          }
        },
        {
          "name": "Get Event Type",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/event-types/{{eventTypeId}}",
              "host": ["{{baseUrl}}"],
              "path": ["event-types", "{{eventTypeId}}"]
            }
          }
        }
      ]
    },
    {
      "name": "Events",
      "item": [
        {
          "name": "Create Event (Admin)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-API-Key",
                "value": "{{adminApiKey}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"eventTypeId\": \"{{eventTypeId}}\",\n  \"name\": \"Sarah & John Wedding\",\n  \"description\": \"A beautiful summer wedding\",\n  \"date\": \"2024-06-15\",\n  \"location\": \"Central Park, NYC\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/events",
              "host": ["{{baseUrl}}"],
              "path": ["events"]
            }
          }
        },
        {
          "name": "List All Events",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/events",
              "host": ["{{baseUrl}}"],
              "path": ["events"]
            }
          }
        },
        {
          "name": "List Events by Type",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/events?eventTypeId={{eventTypeId}}",
              "host": ["{{baseUrl}}"],
              "path": ["events"],
              "query": [
                {
                  "key": "eventTypeId",
                  "value": "{{eventTypeId}}"
                }
              ]
            }
          }
        },
        {
          "name": "Get Event",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/events/{{eventId}}",
              "host": ["{{baseUrl}}"],
              "path": ["events", "{{eventId}}"]
            }
          }
        },
        {
          "name": "Update Event (Admin)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-API-Key",
                "value": "{{adminApiKey}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Updated Event Name\",\n  \"description\": \"Updated description\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/events/{{eventId}}",
              "host": ["{{baseUrl}}"],
              "path": ["events", "{{eventId}}"]
            }
          }
        }
      ]
    },
    {
      "name": "Images",
      "item": [
        {
          "name": "Upload Images (Admin)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-API-Key",
                "value": "{{adminApiKey}}"
              }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "images",
                  "type": "file",
                  "src": []
                },
                {
                  "key": "eventId",
                  "value": "{{eventId}}",
                  "type": "text"
                },
                {
                  "key": "description",
                  "value": "Event photos",
                  "type": "text"
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/images",
              "host": ["{{baseUrl}}"],
              "path": ["images"]
            }
          }
        },
        {
          "name": "List Images by Event",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/images/event/{{eventId}}",
              "host": ["{{baseUrl}}"],
              "path": ["images", "event", "{{eventId}}"]
            }
          }
        },
        {
          "name": "Get Image",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/images/:imageId",
              "host": ["{{baseUrl}}"],
              "path": ["images", ":imageId"],
              "variable": [
                {
                  "key": "imageId",
                  "value": ""
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Bookings",
      "item": [
        {
          "name": "Create Booking",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"eventTypeId\": \"{{eventTypeId}}\",\n  \"customerName\": \"Jane Doe\",\n  \"customerEmail\": \"jane@example.com\",\n  \"customerPhone\": \"+1234567890\",\n  \"eventDate\": \"2024-08-20\",\n  \"eventLocation\": \"Downtown Hotel\",\n  \"message\": \"Looking for wedding photography services\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/bookings",
              "host": ["{{baseUrl}}"],
              "path": ["bookings"]
            }
          }
        },
        {
          "name": "List All Bookings (Admin)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-API-Key",
                "value": "{{adminApiKey}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/bookings",
              "host": ["{{baseUrl}}"],
              "path": ["bookings"]
            }
          }
        },
        {
          "name": "List Bookings by Event Type (Admin)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-API-Key",
                "value": "{{adminApiKey}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/bookings?eventTypeId={{eventTypeId}}",
              "host": ["{{baseUrl}}"],
              "path": ["bookings"],
              "query": [
                {
                  "key": "eventTypeId",
                  "value": "{{eventTypeId}}"
                }
              ]
            }
          }
        }
      ]
    }
  ]
}
